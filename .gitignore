# Rust build output
/target/
**/*.rs.bk

# Local Bifrost state and generated results. The policy scope file is a reviewed
# decision about what the `tests` tree is, so it is tracked, not local state.
/.bifrost/*
!/.bifrost/policy-scope.json
/artifacts/
/results/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
*~

# Coverage and profiling
/coverage/
*.profraw
*.profdata

# Temporary files
*.tmp
*.log
